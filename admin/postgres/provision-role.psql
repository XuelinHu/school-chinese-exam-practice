\set ON_ERROR_STOP on
\set QUIET on
\set app_role school_chinese_exam_practice_app
\set default_database school_chinese_exam_practice_dev
\prompt 'Project database name [school_chinese_exam_practice_dev]: ' requested_database
SELECT COALESCE(NULLIF(:'requested_database', ''), :'default_database') AS app_database \gset
\getenv app_password APP_DB_ROLE_PASSWORD

SELECT CASE WHEN :'app_database' ~ '^[a-z][a-z0-9_]{0,62}$' THEN 1 ELSE 1 / 0 END;

SELECT format($sql$DO $body$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_database WHERE datname = %L
    AND pg_get_userbyid(datdba) IS DISTINCT FROM %L) THEN
    RAISE EXCEPTION 'Database exists with a different owner; inspect and migrate it explicitly';
  END IF;
END $body$;$sql$, :'app_database', :'app_role')\gexec

SELECT length(:'app_password') >= 24 AS password_is_acceptable \gset
\if :password_is_acceptable
\else
  \echo APP_DB_ROLE_PASSWORD must contain at least 24 characters.
  SELECT 1 / 0;
\endif

SELECT format(
  'CREATE ROLE %I LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT',
  :'app_role', :'app_password'
) WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_role')
UNION ALL
SELECT format(
  'ALTER ROLE %I LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT',
  :'app_role', :'app_password'
) WHERE EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_role')
\gexec

SELECT format(
  'CREATE DATABASE %I OWNER %I ENCODING %L TEMPLATE template0',
  :'app_database', :'app_role', 'UTF8'
) WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'app_database')
\gexec

SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'app_database')
\gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO %I', :'app_database', :'app_role')
\gexec
