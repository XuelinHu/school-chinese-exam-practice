# ── 服务 ──────────────────────────────────────────────
PORT=8033
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# ── 数据库 ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=school_chinese_exam_practice

# ── 上传 ──────────────────────────────────────────────
# 头像等上传文件的落盘目录，默认 admin/uploads
ADMIN_UPLOAD_DIR=

# ── 找回密码 ──────────────────────────────────────────
# true 时 POST /api/auth/password/forgot 会直接把 6 位重置码回传给前端，
# 仅用于本地演示；生产必须是 false（重置码写日志，由管理员转达）
AUTH_RESET_RETURN_CODE=false

# ── 本地大模型（Ollama）────────────────────────────────
# 统一走本机 Ollama，不调用任何云端模型服务
AI_ENABLED=true
# 支持 host:port 简写；0.0.0.0 / :: 会自动归一化成 127.0.0.1
OLLAMA_HOST=127.0.0.1:11434
# Ollama 的模型仓库目录，API 不可达时回落到扫描它来发现已下载的模型
# 通常为 ~/.ollama/models
OLLAMA_MODELS=
# 逗号分隔的白名单；留空表示不限制，列出本机全部模型
AI_MODELS=
AI_DEFAULT_MODEL=
# 模型在显存/内存中的保活时长，卸载写 0
AI_KEEP_ALIVE=10m
# 单轮对话最多允许几轮工具调用
AI_MAX_TOOL_ROUNDS=4
# 上下文窗口，显式设置避免 Ollama 默认值过小
AI_NUM_CTX=16384
AI_TIMEOUT_MS=120000
