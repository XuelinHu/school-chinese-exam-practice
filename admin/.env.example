# ── 服务 ──────────────────────────────────────────────
PORT=8033
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# ── 数据库 ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=school_chinese_exam_practice

# ── 上传 ──────────────────────────────────────────────
# 头像等上传文件的落盘目录，默认 admin/uploads
ADMIN_UPLOAD_DIR=

# ── 找回密码 ──────────────────────────────────────────
# true 时 POST /api/auth/password/forgot 会直接把 6 位重置码回传给前端，
# 仅用于本地演示；生产必须是 false（重置码写日志，由管理员转达）
AUTH_RESET_RETURN_CODE=false

# ── 本地大模型（Ollama）────────────────────────────────
# 统一走本机 Ollama，不调用任何云端模型服务
AI_ENABLED=true
# 支持 host:port 简写；0.0.0.0 / :: 会自动归一化成 127.0.0.1
OLLAMA_HOST=127.0.0.1:11434
# Ollama 的模型仓库目录，API 不可达时回落到扫描它来发现已下载的模型。
# 留空会依次探测 /usr/share/ollama/.ollama/models 与 ~/.ollama/models，取第一个存在的。
# 注意：Ollama 以服务用户运行，其家目录未必是你的家目录 —— 本机真实目录是
# /usr/share/ollama/.ollama/models，~/.ollama/models 并不存在。
OLLAMA_MODELS=
# 逗号分隔的白名单；留空表示不限制，列出本机全部模型
AI_MODELS=
AI_DEFAULT_MODEL=
# 单个模型体积上限（GB）。超过的模型仍会出现在下拉里，但标为不可选并写明原因 ——
# 直接隐藏会让人以为模型没下载成功。体积读不到的条目同样视为不可选。
AI_MAX_MODEL_SIZE_GB=24
# 测试专用模型：非空时智能体改用它，用来在本机快速跑通流程。
# **仅在 NODE_ENV 不为 production 时生效**，生产环境设了也会被忽略并打印告警。
# 小模型不会真的调用工具（详情见 README），只适合测试，不要用于交付演示。
AI_TEST_MODEL=
# 模型在显存/内存中的保活时长，卸载写 0
AI_KEEP_ALIVE=10m
# 单轮对话最多允许几轮工具调用
AI_MAX_TOOL_ROUNDS=4
# 上下文窗口，显式设置避免 Ollama 默认值过小
AI_NUM_CTX=16384
AI_TIMEOUT_MS=120000
